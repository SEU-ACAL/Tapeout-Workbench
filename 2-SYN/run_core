#! /bin/sh

usage() {
    cat <<'EOF'
Usage: ./run_core [options]

Options:
  --source-code-home <dir>  Set SOURCE_CODE_HOME for the synthesis Tcl flow.
  --filelist <file>         Set HDL_FILELIST for the synthesis Tcl flow.
  --config <name>           Set the generated Chipyard configuration name.
  --generated-src-root <dir> Set the generated-src parent directory.
  --top <module>            Set TOP_MODULE for the synthesis Tcl flow.
  --sram-wrapper <file>     Optionally set SRAM_WRAPPER_FILE.
  --tech <name>             Select technology configuration (default: tsmc28).
  --corner <name>           Select PVT corner (ss, tt, or ff; default: ss).
  --clock-period <ns>       Set the primary clock period in nanoseconds (default: 10.0).
  --run-id <name>           Write outputs and reports to the specified run directory.
  -h, --help                Show this help message.
EOF
}

tcl_escape() {
    printf '%s' "$1" | sed 's/[\\{}]/\\&/g'
}

require_value() {
    if [ "$#" -lt 2 ] || [ -z "$2" ]; then
        echo "Option $1 requires a value" >&2
        usage >&2
        exit 1
    fi
}

dc_command=""
CORNER=${CORNER:-ss}
while [ "$#" -gt 0 ]; do
    case "$1" in
        --source-code-home)
            require_value "$@"
            SOURCE_CODE_HOME=$2
            shift 2
            ;;
        --filelist)
            require_value "$@"
            HDL_FILELIST=$2
            shift 2
            ;;
        --config)
            require_value "$@"
            CONFIG=$2
            shift 2
            ;;
        --generated-src-root)
            require_value "$@"
            CHIPYARD_GENERATED_SRC=$2
            shift 2
            ;;
        --top)
            require_value "$@"
            TOP_MODULE=$2
            shift 2
            ;;
        --sram-wrapper)
            require_value "$@"
            SRAM_WRAPPER_FILE=$2
            shift 2
            ;;
        --tech)
            require_value "$@"
            TECH_CONFIG=$2
            shift 2
            ;;
        --corner)
            require_value "$@"
            case "$2" in
                ss|tt|ff) CORNER=$2 ;;
                *)
                    echo "Corner must be one of: ss, tt, ff (got $2)" >&2
                    exit 1
                    ;;
            esac
            shift 2
            ;;
        --clock-period)
            require_value "$@"
            case "$2" in
                *[!0-9.eE+-]* | '')
                    echo "Clock period must be a positive number in nanoseconds: $2" >&2
                    exit 1
                    ;;
            esac
            if ! awk "BEGIN { exit !($2 > 0) }"; then
                echo "Clock period must be a positive number in nanoseconds: $2" >&2
                exit 1
            fi
            CLOCK_PERIOD=$2
            shift 2
            ;;
        --run-id)
            require_value "$@"
            RUN_ID=$2
            shift 2
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            echo "Unknown option: $1" >&2
            usage >&2
            exit 1
            ;;
    esac
done

case "$CORNER" in
    ss|tt|ff) ;;
    *)
        echo "Corner must be one of: ss, tt, ff (got $CORNER)" >&2
        exit 1
        ;;
esac

for variable in CONFIG CHIPYARD_GENERATED_SRC SOURCE_CODE_HOME HDL_FILELIST TOP_MODULE SRAM_WRAPPER_FILE TECH_CONFIG CORNER CLOCK_PERIOD RUN_ID; do
    eval "value=\${$variable-}"
    if [ -n "$value" ]; then
        escaped_value=$(tcl_escape "$value")
        dc_command="$dc_command; set $variable {$escaped_value}"
    fi
done

log_date=${RUN_ID:-$(date +%m%d_%H%M)}
mkdir -p outputs/$log_date
mkdir -p rpt/$log_date
rm -f ./alib-52/*
rm -f ./elab/*
dc_shell -f ./scripts/core.tcl -x "set data {$log_date}$dc_command" | tee ./log/core_${log_date}.log
